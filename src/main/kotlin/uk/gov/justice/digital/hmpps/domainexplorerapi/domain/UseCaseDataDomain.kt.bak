package uk.gov.justice.digital.hmpps.domainexplorerapi.domain

import jakarta.persistence.*
import java.time.LocalDateTime

@Entity
@Table(
  name = "use_case_data_domain",
  uniqueConstraints = [UniqueConstraint(columnNames = ["use_case_id", "data_domain_id"], name = "uk_ucdd")],
  indexes = [
    Index(name = "idx_ucdd_use_case_id", columnList = "use_case_id"),
    Index(name = "idx_ucdd_data_domain_id", columnList = "data_domain_id"),
  ],
)
data class UseCaseDataDomain(
  @Id @GeneratedValue(strategy = GenerationType.IDENTITY) val id: Int? = null,
  @ManyToOne(fetch = FetchType.LAZY)
  @JoinColumn(name = "use_case_id", nullable = false)
  val useCase: UseCase,
  @ManyToOne(fetch = FetchType.LAZY)
  @JoinColumn(name = "data_domain_id", nullable = false)
  val dataDomain: DataDomain,
  @Column(columnDefinition = "text") val mappingJustification: String? = null,
  @Column(name = "created_at", nullable = false, updatable = false) val createdAt: LocalDateTime = LocalDateTime.now(),
)
